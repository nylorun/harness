{
  "name": "@nylorun/runtime",
  "version": "0.1.0-rc.1",
  "description": "Production-safe authoring, deterministic build and local execution for Nylo agents.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nylorun/agents.git",
    "directory": "runtime"
  },
  "homepage": "https://github.com/nylorun/agents/tree/main/runtime#readme",
  "bugs": "https://github.com/nylorun/agents/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime-host": {
      "types": "./dist/runtime/host.d.ts",
      "import": "./dist/runtime/host.js"
    },
    "./cli": {
      "import": "./dist/cli/index.js"
    },
    "./agent": {
      "types": "./dist/agent-definition.d.ts",
      "import": "./dist/agent-definition.js"
    },
    "./tool": {
      "types": "./dist/tool-definition.d.ts",
      "import": "./dist/tool-definition.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(({rmSync})=>rmSync('dist',{recursive:true,force:true}))\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:types": "tsc -p test/types/tsconfig.json",
    "check": "npm run build && npm run test:types && npm test && node scripts/generate-contract-reference.mjs --check && node scripts/check-package.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@ag-ui/core": "^0.0.58",
    "@ag-ui/encoder": "^0.0.58",
    "@earendil-works/pi-ai": "0.84.2",
    "@nylorun/agent": "0.1.0-rc.1",
    "@nylorun/harness": "0.4.0-rc.1",
    "typebox": "1.3.7",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
