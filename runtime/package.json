{
  "name": "@nylorun/runtime",
  "version": "0.5.0-beta",
  "description": "SQLite agent Runtime, model providers, and the Nylorun local CLI.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nylorun/harness.git",
    "directory": "runtime"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "nylorun": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./core": {
      "types": "./dist/core/runtime.d.ts",
      "import": "./dist/core/runtime.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "npm run clean && node ../scripts/check-typescript-version.mjs && tsc -p tsconfig.json",
    "check": "npm run build && npm test && node scripts/check-package.mjs",
    "typecheck": "node ../scripts/check-typescript-version.mjs && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "clean": "node -e \"import('node:fs').then(({rmSync})=>rmSync('dist',{recursive:true,force:true}))\"",
    "start": "node dist/core/main.js"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@hono/node-server": "^2.1.1",
    "@nylorun/harness": "0.14.0-beta.3",
    "@nylorun/agents": "0.1.0-beta.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "hono": "^4.13.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.0"
  }
}
