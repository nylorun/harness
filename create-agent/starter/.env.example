# Copy to .env and fill in a provider and model, or run npm run configure.
MODEL_PROVIDER=
MODEL=
MODEL_PROVIDER_API_KEY=
# For MODEL_PROVIDER=custom only:
# MODEL_PROVIDER_BASE_URL=https://your-provider.example/v1

# Optional: Cloud Agents API (sandbox or project). With URL + secret key,
# openSession / Runtime route to Cloud; omit or set NYLORUN_MODE=local for local.
# NYLORUN_URL=https://sandbox.nylorun.dev
# NYLORUN_SECRET_KEY=
# NYLORUN_MODE=cloud
