{
  "name": "@nylorun/studio",
  "version": "0.2.0-rc.3",
  "description": "Developer-only local Studio for Nylo agents.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nylorun/harness.git",
    "directory": "studio"
  },
  "homepage": "https://github.com/nylorun/harness/tree/main/studio#readme",
  "bugs": "https://github.com/nylorun/harness/issues",
  "keywords": [
    "agent",
    "ag-ui",
    "ai",
    "developer-tools",
    "harness",
    "studio"
  ],
  "bin": {
    "nylo": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(({rmSync})=>rmSync('dist',{recursive:true,force:true}))\"",
    "typecheck": "node scripts/check-typescript-version.mjs && tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "build": "npm run clean && npm run typecheck && npm run build:server && npm run build:web",
    "dev": "vite",
    "check": "npm run build && node scripts/check-package.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.58",
    "@assistant-ui/react": "^0.15.16",
    "@assistant-ui/react-ag-ui": "^0.0.56",
    "@assistant-ui/react-markdown": "^0.14.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "lucide-react": "^1.33.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2"
  }
}
