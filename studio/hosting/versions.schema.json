{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.nylorun.studio/versions.schema.json",
  "title": "Studio versions manifest",
  "description": "Hosted Studio versions.json (design §9, contract VersionsManifest).",
  "type": "object",
  "additionalProperties": false,
  "required": ["latest", "protocols"],
  "properties": {
    "latest": {
      "type": "string",
      "minLength": 1,
      "description": "Newest Studio dashboard build version."
    },
    "protocols": {
      "type": "object",
      "description": "Map of Studio protocol number (as string) to newest compatible build version.",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "minProperties": 1
    }
  }
}
