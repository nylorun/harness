{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nylorun.com/schemas/harness/manifest/2.json",
  "title": "Nylorun Harness Agent Manifest",
  "description": "Published agent definition JSON (schemaVersion 2). No top-level model — Runtime-owned.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "capabilities"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "outputSchema": { "type": "object" },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "hasMiddleware"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["agent", "capability", "middleware"] },
          "hasMiddleware": { "type": "boolean" },
          "instructions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "inputSchema"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "description": { "type": "string" },
                "inputSchema": { "type": "object" },
                "outputSchema": { "type": "object" }
              }
            }
          },
          "beforeModelCall": { "type": "boolean" },
          "afterModelCall": { "type": "boolean" }
        }
      }
    }
  }
}
