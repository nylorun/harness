{
  "name": "@nylorun/agents",
  "version": "0.1.0-rc.0",
  "description": "TypeScript authoring and deterministic build tooling for Nylo agents.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nylorun/agents.git",
    "directory": "agents"
  },
  "homepage": "https://github.com/nylorun/agents/tree/main/agents#readme",
  "bugs": "https://github.com/nylorun/agents/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.14 <23"
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(({rmSync})=>rmSync('dist',{recursive:true,force:true}))\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:types": "tsc -p test/types/tsconfig.json",
    "check": "npm run build && npm run test:types && npm test && node scripts/check-package.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
