# Display label for the configured endpoint.
NYLO_PROVIDER=OpenRouter
NYLO_MODEL=google/gemini-2.5-flash
NYLO_BASE_URL=https://openrouter.ai/api/v1
NYLO_API_KEY=
# Optional JSON object for provider-specific headers, for example Portkey virtual keys.
# NYLO_HEADERS_JSON={"x-portkey-virtual-key":"pk-..."}
# Optional dedicated OpenAI Images credentials for the Interior Design agent.
# The chat provider above remains independent; choose a vision-capable NYLO_MODEL for image input.
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2
# Optional Codex CLI auth for the Coding Agent. Independent of NYLO_*.
# CODEX_API_KEY=
