# Model provider credentials are stored in the Runtime vault (.nylorun/), not here.
# The first nylorun dev prompts for them, or seeds them once from:
# MODEL_PROVIDER=...
# MODEL=...
# MODEL_PROVIDER_API_KEY=...
# MODEL_PROVIDER_BASE_URL=... # only for a custom provider
# PORT=8787
# NYLORUN_IMPLEMENTATION_VERSION=dev
