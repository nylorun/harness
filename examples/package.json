{
  "name": "nylorun-harness-examples",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "configure": "nylorun configure",
    "dev": "nylorun dev",
    "studio": "nylorun studio --runtime-url http://127.0.0.1:8787",
    "build": "node -e \"import('node:fs/promises').then(async ({rm,cp}) => { await rm('dist', { recursive: true, force: true }); await cp('agents', 'dist/agents', { recursive: true, filter: (source) => !source.endsWith('.ts') }); })\" && tsc -p tsconfig.build.json",
    "start": "nylorun start",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "codex:preflight": "node scripts/codex-preflight.mjs",
    "docker:preflight": "node scripts/docker-preflight.mjs"
  },
  "dependencies": {
    "@nylorun/runtime": "file:../runtime",
    "zod": "^4.5.4",
    "@nylorun/agents": "file:../agents",
    "@nylorun/harness": "file:../harness",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod-from-json-schema": "^0.5.6"
  },
  "devDependencies": {
    "@nylorun/studio": "file:../studio",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
