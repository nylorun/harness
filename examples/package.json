{
  "name": "nylorun-harness-examples",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "prestudio": "npm run build --prefix ../studio",
    "studio": "node --env-file-if-exists=.env scripts/studio.mjs",
    "build": "vite build --ssr server/main.ts --outDir dist",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "docker:preflight": "node scripts/docker-preflight.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@hono/node-server": "^1.19.10",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@nylorun/harness": "file:../harness",
    "@nylorun/studio": "file:../studio",
    "hono": "^4.11.10",
    "zod-from-json-schema": "^0.5.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
